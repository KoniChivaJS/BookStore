@host = http://localhost:8080
@contentType = application/json

# Task 9: every request below sends "Authorization: Bearer <JWT>" instead of Basic auth.
# Run top-to-bottom: the 4 logins save one token per user, the rest reuse them.
#   user@bookstore.com       / user        -> USER
#   admin@bookstore.com      / admin       -> ADMIN
#   superadmin@bookstore.com / superadmin  -> SUPERADMIN
#   john@mail.com            / password    -> ADMIN

### L1. Login as USER -> save token as {{userToken}}
POST {{host}}/api/auth/authenticate
Content-Type: {{contentType}}

{
  "email": "user@bookstore.com",
  "password": "user"
}

> {%
    client.global.set("userToken", response.body.token);
%}

### L2. Login as ADMIN -> save token as {{adminToken}}
POST {{host}}/api/auth/authenticate
Content-Type: {{contentType}}

{
  "email": "admin@bookstore.com",
  "password": "admin"
}

> {%
    client.global.set("adminToken", response.body.token);
%}

### L3. Login as SUPERADMIN -> save token as {{superToken}}
POST {{host}}/api/auth/authenticate
Content-Type: {{contentType}}

{
  "email": "superadmin@bookstore.com",
  "password": "superadmin"
}

> {%
    client.global.set("superToken", response.body.token);
%}

### L4. Login as John (ADMIN) -> save token as {{johnToken}}
POST {{host}}/api/auth/authenticate
Content-Type: {{contentType}}

{
  "email": "john@mail.com",
  "password": "password"
}

> {%
    client.global.set("johnToken", response.body.token);
%}

### 1. ADMIN token -> /hello/admin -> 200
GET {{host}}/api/hello/admin
Authorization: Bearer {{adminToken}}

> {%
    client.test("ADMIN token -> /hello/admin: 200", () => {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 2. USER token -> /hello/admin -> 403
GET {{host}}/api/hello/admin
Authorization: Bearer {{userToken}}

> {%
    client.test("USER token -> /hello/admin: 403", () => {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### 3. USER token -> /hello/user -> 200
GET {{host}}/api/hello/user
Authorization: Bearer {{userToken}}

> {%
    client.test("USER token -> /hello/user: 200", () => {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 4. ADMIN token -> /hello/user -> 403
GET {{host}}/api/hello/user
Authorization: Bearer {{adminToken}}

> {%
    client.test("ADMIN token -> /hello/user: 403", () => {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

