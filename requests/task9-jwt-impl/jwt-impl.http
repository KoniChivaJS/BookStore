### 10. USER token -> GET /api/books -> 200
GET {{host}}/api/books
Authorization: Bearer {{userToken}}

> {%
    client.test("USER token -> GET /api/books: 200", () => {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### 11. USER token -> POST /api/books -> 403
POST {{host}}/api/books
Content-Type: {{contentType}}
Authorization: Bearer {{userToken}}

{
  "title": "Refactoring",
  "author": "Martin Fowler",
  "genre": "Programming",
  "isbn": "9780134757599",
  "price": 47.00,
  "stock": 3,
  "year": 2018
}

> {%
    client.test("USER token -> POST /api/books: 403", () => {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### 12. ADMIN token -> DELETE /api/books/{id} (only SUPERADMIN) -> 403
DELETE {{host}}/api/books/000000000000000000000000
Authorization: Bearer {{adminToken}}

> {%
    client.test("ADMIN token -> DELETE /api/books/{id} (only SUPERADMIN): 403", () => {
        client.assert(response.status === 403, "Expected 403 but got " + response.status);
    });
%}

### 13. No token -> GET /api/books -> 401
GET {{host}}/api/books

> {%
    client.test("No token -> GET /api/books: 401", () => {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

### 14. Forged token -> GET /api/books -> 401
GET {{host}}/api/books
Authorization: Bearer eyJhbGciOiJIUzUxMiJ9.eyJzdWIiOiJhZG1pbkBib29rc3RvcmUuY29tIn0.forged-signature

> {%
    client.test("Forged token: 401", () => {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}
