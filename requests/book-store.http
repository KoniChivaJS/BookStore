@host = http://localhost:8080
@contentType = application/json

### 1. GET all books
GET {{host}}/api/books
Accept: {{contentType}}

### 2. Search books by title
GET {{host}}/api/books?title=code
Accept: {{contentType}}

### 3. Search books by author
GET {{host}}/api/books?author=orwell
Accept: {{contentType}}

### 4. CREATE a book
POST {{host}}/api/books
Content-Type: {{contentType}}

{
  "title": "Domain-Driven Design",
  "author": "Eric Evans",
  "genre": "Software Architecture",
  "isbn": "9780321125217",
  "price": 54.90,
  "stock": 5,
  "year": 2003
}

> {%
    client.global.set("bookId", response.body.id);
    client.test("Created with 201", () => {
        client.assert(response.status === 201, "Expected 201 but got " + response.status);
    });
%}

### 5. GET the book we just created (by id)
GET {{host}}/api/books/{{bookId}}
Accept: {{contentType}}

### 6. UPDATE that book (price + stock changed)
PUT {{host}}/api/books/{{bookId}}
Content-Type: {{contentType}}

{
  "title": "Domain-Driven Design",
  "author": "Eric Evans",
  "genre": "Software Architecture",
  "isbn": "9780321125217",
  "price": 49.99,
  "stock": 8,
  "year": 2003
}

### 7. DELETE that book
DELETE {{host}}/api/books/{{bookId}}

> {%
    client.test("Deleted with 204", () => {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### 8. GET a missing book -> 404 (error handling demo)
GET {{host}}/api/books/000000000000000000000000
Accept: {{contentType}}

### 9. CREATE invalid book -> 400 (validation demo: empty title/author, negative price)
POST {{host}}/api/books
Content-Type: {{contentType}}

{
  "title": "",
  "author": "",
  "genre": "n/a",
  "isbn": "n/a",
  "price": -3,
  "stock": 0,
  "year": 2024
}

### 10. CREATE with broken JSON -> 400 (malformed body demo)
POST {{host}}/api/books
Content-Type: {{contentType}}

{ "title": "oops", "author": }
